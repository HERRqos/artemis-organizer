# --- Meta / WhatsApp Cloud API ---
META_APP_SECRET=            # App dashboard > Settings > Basic
META_VERIFY_TOKEN=          # any string you invent; paste the same one into Meta
WHATSAPP_TOKEN=             # permanent token from a System User
WHATSAPP_PHONE_NUMBER_ID=
GRAPH_API_VERSION=v21.0
REMINDER_TEMPLATE=appointment_reminder

# --- LLM ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Google Calendar ---
GOOGLE_CREDENTIALS_FILE=/secrets/google-sa.json
CALENDAR_ID=               # her calendar's ID, shared with the service account

# --- Practice ---
OWNER_NAME=
OWNER_WHATSAPP=            # her number, for handoff notifications
TIMEZONE=Europe/Madrid
OFFICE_OPEN=09:00
OFFICE_CLOSE=19:00
OFFICE_DAYS=0,1,2,3,4      # 0 = Monday
SLOT_MINUTES=60

# --- Infra ---
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://postgres:dev@postgres:5432/assistant
QUEUE_NAME=inbound
